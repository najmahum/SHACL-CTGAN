###  http://www.semanticweb.org/najma/ontologies/homecredit/hasNumberOfAdults
:hasNumberOfAdults rdf:type owl:DatatypeProperty ;
    rdfs:domain :Applicant ;
    rdfs:range xsd:integer ;
    :valueRange "Allowed values: 1, 2. 2 if hasFamilyStatus is Married or Civil marriage, otherwise 1."@en ;
    rdfs:comment "hasNumberOfFamilyMembers is expected to equal hasNumberOfChildren + hasNumberOfAdults."@en ;
    skos:definition "Number of adults in the applicant's household, derived from family status."@en .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasCityMismatchCount
:hasCityMismatchCount rdf:type owl:DatatypeProperty ;
    rdfs:domain :ResidenceInformation ;
    rdfs:range xsd:integer ;
    :valueRange "Allowed values: 0, 2, 3. The value 1 is impossible because city equality is transitive among registration, living and work addresses."@en ;
    skos:definition "Sum of hasRegistrationLivingCityDifference, hasRegistrationWorkCityDifference and hasLivingWorkCityDifference."@en .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasRegionMismatchCount
:hasRegionMismatchCount rdf:type owl:DatatypeProperty ;
    rdfs:domain :ResidenceInformation ;
    rdfs:range xsd:integer ;
    :valueRange "Allowed values: 0, 2, 3. Same transitivity rule as city; the same city implies the same region."@en ;
    skos:definition "Sum of the three region difference flags."@en .


