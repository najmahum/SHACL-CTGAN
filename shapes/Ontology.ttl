                          rdfs:domain :CreditBureauHistory ;
                          rdfs:range xsd:float ;
                          dcterms:source "Home Credit Group, HomeCredit_columns_description.csv (competition 'Home Credit Default Risk', Kaggle), application_train.csv, column AMT_REQ_CREDIT_BUREAU_DAY. https://www.kaggle.com/competitions/home-credit-default-risk/data"@en ;
