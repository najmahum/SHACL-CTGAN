###  http://www.semanticweb.org/najma/ontologies/homecredit/hasCreditRiskStatus
:hasCreditRiskStatus rdf:type owl:DatatypeProperty ;
                     rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/LoanApplication> ;
                     rdfs:range xsd:integer ;
