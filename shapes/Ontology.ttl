@prefix : <http://www.semanticweb.org/najma/ontologies/homecredit/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://www.semanticweb.org/najma/ontologies/homecredit/> .

<http://www.semanticweb.org/najma/ontologies/homecredit/> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/source
dcterms:source rdf:type owl:AnnotationProperty .


###  http://www.semanticweb.org/najma/ontologies/homecredit/rangeSource
:rangeSource rdf:type owl:AnnotationProperty ;
             rdfs:comment "Source of the range, allowed values or threshold given in valueRange."@en .


###  http://www.semanticweb.org/najma/ontologies/homecredit/valueRange
:valueRange rdf:type owl:AnnotationProperty ;
            rdfs:comment "Valid range, allowed values or regulatory/literature threshold used to validate data for the annotated property."@en .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/najma/ontologies/homecredit/SubmittedBy
:SubmittedBy rdf:type owl:ObjectProperty ;
             rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/LoanApplication> ;
             rdfs:range :Applicant .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasContactInformation
:hasContactInformation rdf:type owl:ObjectProperty ;
                       rdfs:domain :Applicant ;
                       rdfs:range :ContactInformation .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasCreditBureauHistory
:hasCreditBureauHistory rdf:type owl:ObjectProperty ;
                        rdfs:domain :Applicant ;
                        rdfs:range :CreditBureauHistory .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasExternalAssessment
:hasExternalAssessment rdf:type owl:ObjectProperty ;
                       rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/LoanApplication> ;
                       rdfs:range :ExternalAssessment .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasPropertyInfo
:hasPropertyInfo rdf:type owl:ObjectProperty ;
                 rdfs:domain :Applicant ;
                 rdfs:range :PropertyInformation .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasResidenceInformation
:hasResidenceInformation rdf:type owl:ObjectProperty ;
                         rdfs:domain :Applicant ;
                         rdfs:range :ResidenceInformation .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasSocialSurroundings
:hasSocialSurroundings rdf:type owl:ObjectProperty ;
                       rdfs:domain :Applicant ;
                       rdfs:range :SocialSurroundings .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/najma/ontologies/homecredit/hasAgeInDays
:hasAgeInDays rdf:type owl:DatatypeProperty ;
              rdfs:domain :Applicant ;
              rdfs:range xsd:integer ;
              dcterms:source "Home Credit Group, HomeCredit_columns_description.csv (competition 'Home Credit Default Risk', Kaggle), application_train.csv, column DAYS_BIRTH. https://www.kaggle.com/competitions/home-credit-default-risk/data"@en ;
              :rangeSource "Observed range in the real application_train.csv (Home Credit Group, Kaggle 'Home Credit Default Risk'); min-max as displayed by the dataset viewer of that file, https://huggingface.co/datasets/jlh/home-credit (viewer rounds large values). Confirm exact values with application_train.describe() on your own download."@en ;
              :valueRange "Observed range: -25229 to -7489. Note: Negative days before application; equals an age of about 20.5 to 69.1 years."@en ;
              skos:definition "Applicant's age at the time of application, stored as a negative number of days counted back from the application date."@en .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasAgeYears
:hasAgeYears rdf:type owl:DatatypeProperty ;
             rdfs:domain :Applicant ;
             rdfs:range xsd:decimal ;
             dcterms:source "Home Credit Group, HomeCredit_columns_description.csv (competition 'Home Credit Default Risk', Kaggle), application_train.csv, column DAYS_BIRTH. https://www.kaggle.com/competitions/home-credit-default-risk/data"@en ,
                            "Kitab Undang-Undang Hukum Perdata (KUHPerdata / Burgerlijk Wetboek), Pasal 330 (belum dewasa: belum genap 21 tahun dan tidak kawin sebelumnya)."@en ;
             :rangeSource "Kitab Undang-Undang Hukum Perdata (KUHPerdata / Burgerlijk Wetboek), Pasal 330 (belum dewasa: belum genap 21 tahun dan tidak kawin sebelumnya)."@en ,
                          "Observed range in the real application_train.csv (Home Credit Group, Kaggle 'Home Credit Default Risk'); min-max as displayed by the dataset viewer of that file, https://huggingface.co/datasets/jlh/home-credit (viewer rounds large values). Confirm exact values with application_train.describe() on your own download."@en ,
                          "Peraturan Anggota Dewan Komisioner OJK No. 2 Tahun 2026 tentang Penyelenggaraan Beli Sekarang Bayar Nanti (BNPL) bagi Perusahaan Pembiayaan dan Perusahaan Pembiayaan Syariah: calon debitur minimal 18 tahun atau telah menikah, penghasilan bruto minimal Rp3.000.000 per bulan; berlaku paling lambat 1 Juli 2026."@en ,
                          "Surat Edaran OJK No. 19/SEOJK.06/2025 tentang Penyelenggaraan LPBBTI (turunan POJK No. 40 Tahun 2024): penerima dana minimal 18 tahun atau telah menikah; rasio utang terhadap penghasilan paling tinggi 40% pada 2025 dan 30% mulai 2026 (as reported by Bisnis.com, https://finansial.bisnis.com/read/20260112/563/1943510/tahun-ini-batas-maksimal-kredit-pinjol-diperketat-jadi-30-dari-gaji; verify against the official text)."@en ;
             :valueRange "Observed range: 20.5 to 69.07. Regulatory/literature threshold: Minimum age to contract: 18 years or married (OJK PADK 2/2026; SEOJK 19/2025); 21 years or married (KUHPerdata Art. 330). Note: Derived from the observed DAYS_BIRTH range. The real minimum (about 20.5 years) is below 21, so a 21-year rule would mark some real applicants as not of legal age unless married; an 18-year rule marks none."@en ;
             rdfs:comment "Calculated as (-hasAgeInDays / 365.25). KUHPerdata Article 330 provides the age threshold of 21 years or the exception for a person who is married."@en ;
             skos:definition "Applicant's age in years, derived from hasAgeInDays by taking the absolute number of days and dividing by 365.25."@en .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasAnnuityAmount
:hasAnnuityAmount rdf:type owl:DatatypeProperty ;
                  rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/LoanApplication> ;
                  rdfs:range xsd:float ;
                  dcterms:source "Home Credit Group, HomeCredit_columns_description.csv (competition 'Home Credit Default Risk', Kaggle), application_train.csv, column AMT_ANNUITY. https://www.kaggle.com/competitions/home-credit-default-risk/data"@en ;
                  :rangeSource "Berry, J., Home Credit Default notebook: AMT_INCOME_TOTAL maximum 117,000,000; AMT_REQ_CREDIT_BUREAU_QRT outlier 261; missing-value counts per column. https://jareddberry.github.io/files/hcd_notebook.html"@en ,
                               "Observed range in the real application_train.csv (Home Credit Group, Kaggle 'Home Credit Default Risk'); min-max as displayed by the dataset viewer of that file, https://huggingface.co/datasets/jlh/home-credit (viewer rounds large values). Confirm exact values with application_train.describe() on your own download."@en ;
                  :valueRange "Observed range: ~1.6k to ~258k. Note: About 12 real rows are empty."@en ;
                  skos:definition "Loan annuity: the periodic installment amount of the loan."@en .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasApartmentsAvg
:hasApartmentsAvg rdf:type owl:DatatypeProperty ;
                  rdfs:domain :PropertyInformation ;
                  rdfs:range xsd:float ;
                  dcterms:source "Home Credit Group, HomeCredit_columns_description.csv (competition 'Home Credit Default Risk', Kaggle), application_train.csv, column APARTMENTS_AVG. https://www.kaggle.com/competitions/home-credit-default-risk/data"@en ;
                  :rangeSource "Observed range in the real application_train.csv (Home Credit Group, Kaggle 'Home Credit Default Risk'); min-max as displayed by the dataset viewer of that file, https://huggingface.co/datasets/jlh/home-credit (viewer rounds large values). Confirm exact values with application_train.describe() on your own download."@en ;
                  :valueRange "Observed range: 0 to 1. Note: Normalized value; the dataset does not use real units."@en ;
                  skos:definition "Normalized (0 to 1) average of the apartment size in the building where the applicant lives."@en .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasApartmentsMedi
:hasApartmentsMedi rdf:type owl:DatatypeProperty ;
