###  http://www.semanticweb.org/najma/ontologies/homecredit/hasEstimatedTenorMonths
:hasEstimatedTenorMonths rdf:type owl:DatatypeProperty ;
                         rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/LoanApplication> ;
                         rdfs:range xsd:decimal ;
                         dcterms:source "Home Credit Group, HomeCredit_columns_description.csv (competition 'Home Credit Default Risk', Kaggle), application_train.csv, columns AMT_CREDIT, AMT_ANNUITY. https://www.kaggle.com/competitions/home-credit-default-risk/data"@en ,
                                        "Peraturan Otoritas Jasa Keuangan No. 35/POJK.05/2018 tentang Penyelenggaraan Usaha Perusahaan Pembiayaan, Pasal 34 (perjanjian pembiayaan; jangka waktu sebagai informasi kontraktual). https://www.ojk.go.id/id/regulasi/Documents/Pages/Penyelenggaraan-Usaha-Perusahaan-Pembiayaan/pojk%2035-2018.pdf"@en ;
                         :rangeSource "Peraturan Otoritas Jasa Keuangan No. 35/POJK.05/2018 tentang Penyelenggaraan Usaha Perusahaan Pembiayaan, Pasal 34 (perjanjian pembiayaan; jangka waktu sebagai informasi kontraktual). https://www.ojk.go.id/id/regulasi/Documents/Pages/Penyelenggaraan-Usaha-Perusahaan-Pembiayaan/pojk%2035-2018.pdf"@en ;
                         :valueRange "Observed range: 0 to no fixed maximum. Regulatory/literature threshold: Tenor is a contractual term (POJK 35/2018 Art. 34); no regulatory range for this approximation. Note: Cash loans only; credit / annuity without interest."@en ;
                         rdfs:comment "Estimated as hasCreditAmount / hasAnnuityAmount, without accounting for interest. This is an approximate tenor derived from dataset values. POJK 35/2018 Article 34 treats tenor as contractual information; it does not define this calculation. Only for Loan Type Cash Loans."@en ;
                         skos:definition "Approximate loan term in months, derived as credit amount divided by annuity without interest. A contractual tenor is stated in the financing agreement (POJK 35/2018 Art. 34)."@en .


