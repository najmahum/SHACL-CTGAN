                   :rangeSource "Observed range in the real application_train.csv (Home Credit Group, Kaggle 'Home Credit Default Risk'); min-max as displayed by the dataset viewer of that file, https://huggingface.co/datasets/jlh/home-credit (viewer rounds large values). Confirm exact values with application_train.describe() on your own download."@en ;
                   :valueRange "Observed range: 0 to 1. Note: Normalized value; the dataset does not use real units."@en ;
                   skos:definition "Normalized (0 to 1) median of the apartment size in the building where the applicant lives."@en .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasApartmentsMode
:hasApartmentsMode rdf:type owl:DatatypeProperty ;
                   rdfs:domain :PropertyInformation ;
                   rdfs:range xsd:float ;
                   dcterms:source "Home Credit Group, HomeCredit_columns_description.csv (competition 'Home Credit Default Risk', Kaggle), application_train.csv, column APARTMENTS_MODE. https://www.kaggle.com/competitions/home-credit-default-risk/data"@en ;
                   :rangeSource "Observed range in the real application_train.csv (Home Credit Group, Kaggle 'Home Credit Default Risk'); min-max as displayed by the dataset viewer of that file, https://huggingface.co/datasets/jlh/home-credit (viewer rounds large values). Confirm exact values with application_train.describe() on your own download."@en ;
                   :valueRange "Observed range: 0 to 1. Note: Normalized value; the dataset does not use real units."@en ;
                   skos:definition "Normalized (0 to 1) mode (most frequent value) of the apartment size in the building where the applicant lives."@en .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasApplicantGender
:hasApplicantGender rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Applicant ;
                    rdfs:range xsd:string ;
                    dcterms:source "Home Credit Group, HomeCredit_columns_description.csv (competition 'Home Credit Default Risk', Kaggle), application_train.csv, column CODE_GENDER. https://www.kaggle.com/competitions/home-credit-default-risk/data"@en ;
                    :rangeSource "Category set of the real application_train.csv (Home Credit Group, Kaggle); number of classes confirmed in https://huggingface.co/datasets/jlh/home-credit; confirm the exact labels with value_counts() on your own download."@en ;
                    :valueRange "Allowed values: F, M, XNA (3 classes)."@en ;
                    skos:definition "Gender of the applicant."@en .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasApplicationID
:hasApplicationID rdf:type owl:DatatypeProperty ;
                  rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/LoanApplication> ;
                  rdfs:range xsd:integer ;
                  dcterms:source "Home Credit Group, HomeCredit_columns_description.csv (competition 'Home Credit Default Risk', Kaggle), application_train.csv, column SK_ID_CURR. https://www.kaggle.com/competitions/home-credit-default-risk/data"@en ;
                  :rangeSource "Observed range in the real application_train.csv (Home Credit Group, Kaggle 'Home Credit Default Risk'); min-max as displayed by the dataset viewer of that file, https://huggingface.co/datasets/jlh/home-credit (viewer rounds large values). Confirm exact values with application_train.describe() on your own download."@en ;
                  :valueRange "Observed range: ~100k to ~456k. Note: Integer identifier, unique per application."@en ;
                  skos:definition "Identifier of the loan application in the Home Credit sample."@en .


###  http://www.semanticweb.org/najma/ontologies/homecredit/hasApplicationStartDay
:hasApplicationStartDay rdf:type owl:DatatypeProperty ;
                        rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/LoanApplication> ;
                        rdfs:range xsd:string ;
                        dcterms:source "Home Credit Group, HomeCredit_columns_description.csv (competition 'Home Credit Default Risk', Kaggle), application_train.csv, column WEEKDAY_APPR_PROCESS_START. https://www.kaggle.com/competitions/home-credit-default-risk/data"@en ;
                        :rangeSource "Category set of the real application_train.csv (Home Credit Group, Kaggle); number of classes confirmed in https://huggingface.co/datasets/jlh/home-credit; confirm the exact labels with value_counts() on your own download."@en ;
                        :valueRange "Allowed values: MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY."@en ;
